// Prisma schema for CareerPilot AI (SQLite, local-first)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Application {
  id            String   @id @default(cuid())
  jobUrl        String
  portal        String   // "greenhouse" | "lever" | "linkedin" | "workday"
  status        String   @default("pending") // "pending" | "submitted" | "failed"
  screenshotUrl String?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  location  String?
  linkedin  String?
  updatedAt DateTime @updatedAt
}
